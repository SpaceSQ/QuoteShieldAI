# Quote Shield AI edge functions. No real secrets.
# Hosted Supabase injects SUPABASE_URL plus publishable/secret keys.
# SUPABASE_SERVICE_ROLE_KEY is accepted as an alias of the secret key for local serves.

OPENAI_API_KEY=
XAI_API_KEY=
LLM_PROVIDER=openai
LLM_CHEAP_MODEL=gpt-4o-mini
LLM_STRONG_MODEL=gpt-4o
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional. For xAI Grok vision set:
# LLM_PROVIDER=xai
# LLM_CHEAP_MODEL=grok-2-vision-1212
# LLM_STRONG_MODEL=grok-2-vision-1212
# XAI_API_KEY=

# Local only. Never enable in production.
# ALLOW_DEV_UNLOCK=true

# Production unlock checks this server-side. A client isPro flag is not enough.
# REVENUECAT_SECRET_API_KEY=

# Injected by `supabase functions serve` / the hosted runtime. Optional locally:
# SUPABASE_ANON_KEY=
# SUPABASE_SECRET_KEY=
